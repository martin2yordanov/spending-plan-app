# Clerk publishable key. Leave unset to run the app logged-out with example
# data. MUST be a production key (pk_live_...) for an App Store build — a
# development instance has hard usage limits and is not supported in production.
VITE_CLERK_PUBLISHABLE_KEY=

# Absolute base URL of the deployed API. Leave EMPTY for web builds, where the
# app and /api share an origin. REQUIRED for native builds: the Capacitor
# WebView runs at capacitor://localhost, which has no /api of its own.
#   e.g. VITE_API_BASE_URL=https://spending-plan-app.vercel.app
VITE_API_BASE_URL=

# Server-side only (set in Vercel, never in the client bundle).
# REDIS_URL=
# GROQ_API_KEY=
#
# Clerk's SECRET key (not the publishable one above) — Dashboard > API Keys.
# Without it, api/data.js CANNOT verify who is writing to a user_* id — every
# write stays unauthenticated (unchanged from before this was added), and a
# warning is logged on every such write. Set this to actually enforce that a
# write can only come from a session for that same id.
# CLERK_SECRET_KEY=
